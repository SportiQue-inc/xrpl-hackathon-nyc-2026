+++ b/src/research-studio-ui/pages/ResearchParticipantsPage.tsx	2026-10-25 05:19:25.266694645 +0000
@@ -0,0 +1,39 @@
+import { useEffect, useRef, useState } from "react";
+import { getClientEnv } from "@/lib/env";
+
+// AgentRail researcher console (participants, rounds with 2-signer budget approval, ledger receipts).
+// The same modules the hackathon engine serves at /console are loaded from the engine origin, so
+// both places run one source. Synthetic data and XRPL Testnet only.
+type Mounted = { stop: () => void };
+
+export default function ResearchParticipantsPage() {
+  const host = useRef<HTMLDivElement>(null);
+  const [error, setError] = useState<string | null>(null);
+  const base = (getClientEnv({ vite: "VITE_AGENTRAIL_API_URL", fallback: "http://localhost:8000" }) ?? "").replace(/\/$/, "");
+
+  useEffect(() => {
+    let mounted: Mounted | null = null;
+    let cancelled = false;
+    const css = document.createElement("link");
+    css.rel = "stylesheet";
+    css.href = `${base}/apps/shared/ui.css`;
+    document.head.appendChild(css);
+    import(/* @vite-ignore */ `${base}/apps/shared/researcher.js`)
+      .then((m) => {
+        if (!cancelled && host.current) mounted = m.mountResearcher(host.current, { base, embedded: true });
+      })
+      .catch(() => setError("연구 기여 엔진에 연결하지 못했습니다. VITE_AGENTRAIL_API_URL을 확인하세요."));
+    return () => {
+      cancelled = true;
+      mounted?.stop();
+      css.remove();
+    };
+  }, [base]);
+
+  return (
+    <div className="py-2">
+      {error ? <p className="text-sm text-[#DC2626]">{error}</p> : null}
+      <div ref={host} />
+    </div>
+  );
+}
