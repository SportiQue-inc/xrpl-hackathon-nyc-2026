# Copy to ap4m/.env (git-ignored) and fill from the AP4M participant portal, My setup tab.
# Never commit .env or paste key values anywhere.

# AP4M service (default https://hackathon.ap4m.build)
AP4M_API_URL=
# Registered team name, used by signIn
TEAM_NAME=

# Agent wallet: added on the portal, funded budget, XRP for gas (XRPL EVM Testnet faucet)
AGENT_PRIVATE_KEY=

# Team Merchant (portal My setup tab or GET /public/participant/me)
MERCHANT_ID=
# Merchant payout wallet address; RLUSD lands here at settlement (MERCHANT_PAYOUT_ADDRESS also accepted)
MERCHANT_PAYOUT=
# Wallet with XRP for gas that sends the merchant's redemptions (the payout wallet works)
MERCHANT_SUBMITTER_KEY=

# Optional
# CHANNEL_ID=            reuse an open Channel instead of opening one
# CHANNEL_CAP=           Channel limit in RLUSD when opening one (default: BUDGET_RLUSD)
# PER_CALL_CAP_RLUSD=    default 0.10
# BUDGET_RLUSD=          delegated budget for the task, default 0.20
# PAYEE_ALLOWLIST=       comma-separated; default MERCHANT_PAYOUT
# MERCHANT_PORT=         default 4400 (x402 instances use 4401-4404)
# AP4M_RPC_URL=          default from /public/config
# CLOSE_CHANNEL=1        close the Channel after settling
