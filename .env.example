# Copy to .env (git-ignored) and fill in. Never commit .env.
# Agent voice: openai | anthropic | none. Without a key the agents use rule-based sentences.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=o3-mini   # widest per-minute limit on the team project; any chat model works
# Optional
# ANTHROPIC_API_KEY=
# XRPL_RPC_URL=https://s.altnet.rippletest.net:51234/
# PAYMENT_RAIL=x402
# LLM answers are recorded to fixtures/llm_cache.json and replayed when the live call fails
# LLM_RECORD=1
# LLM_SAY=0          # 1 = also let the LLM phrase agent messages (uses more calls)
# LLM_MAX_CALLS=60
# LLM_RPM=60         # client-side pacing (project limit for o3-mini is 150 RPM)
