# Copy to .env (git-ignored) and fill in. Never commit .env.
# Agent voice: openai | anthropic | none. Without a key the agents use rule-based sentences.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
