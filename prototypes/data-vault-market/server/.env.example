# Copy to .env next to this file (or use the repository's .env). Never commit it.
VM_LEDGER=testnet                 # testnet (real XRPL Testnet) | mock (tests only; every page says "test ledger")
VM_AGENTS=50
VM_TICK_SECONDS=15                # one negotiation round per tick
VM_DROPS_PER_UNIT=10000           # 1 price unit = 0.01 XRP on the ledger
# Agents' LLM: anthropic or openai, picked from whichever key is set
# ANTHROPIC_API_KEY=
# VM_ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_API_KEY=
# VM_OPENAI_MODEL=gpt-4.1-mini
VM_LLM_RPM=20                     # all agents together, calls per minute
VM_LLM_DAILY_CALLS=3000           # hard daily cap; after it the agents answer from their written rules
