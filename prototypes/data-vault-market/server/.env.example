# Copy to .env next to this file (or use the repository's .env). Never commit it.
VM_LEDGER=testnet                 # testnet | devnet (real XRPL) | mock (tests only; every page says "test ledger")
VM_AGENTS=50
VM_TICK_SECONDS=15                # one negotiation round per tick
VM_ASSET=USD                      # USD: test USD token standing in for RLUSD (token escrow) | XRP: fallback
VM_USD_PER_UNIT=1                 # 1 price unit = 1 test USD
VM_DROPS_PER_UNIT=10000           # XRP fallback: 1 price unit = 0.01 XRP
# Agents' LLM: anthropic or openai, picked from whichever key is set
# ANTHROPIC_API_KEY=
# VM_ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_API_KEY=
# VM_OPENAI_MODEL=gpt-5-nano,gpt-4o-mini,gpt-5.4-nano,gpt-5-mini,gpt-5.4-mini,gpt-4.1-mini,o4-mini   # tried in order; a 429 rests that model until its reset
VM_LLM_RPM=4                      # all agents together, calls per minute
VM_LLM_DAILY_CALLS=320            # daily cap, paced over the UTC day; after it the agents answer from their written rules
